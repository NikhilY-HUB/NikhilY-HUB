user = 'Name@123'
a = input('Enter your username: ')
upper = 0
lower = 0
special = 0
digit = 0
if a == user:
  p = input('Enter you password: ')
  for i in p:
    if i.isupper():
      upper += 1
    elif i.islower():
      lower += 1
    elif i.isdigit():
      digit += 1
    else:
      special += 1

  if len(p) < 8:
    print('Password is too short')
  elif upper == 0 or lower == 0 or digit == 0 or special == 0:
    print('Invalid Password')
  elif " " in p:
    print('Invalid Format')
  else:
    print('Welcome User')
else:
  print('Wrong username')
