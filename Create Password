user = 'Name@123'
a = input('Enter your username: ')
upper = 0
lower = 0
special = 0
digit = 0
if a == user:
  print('''Password must contain:
        1. At least 1 Uppercase letter 
        2. At least 1 Lowercase letter
        3. At least 1 Digit 
        4. At least 1 Special Character
        5. At least 8 characters
        6. No spaces allowed
        7. Password should not be the same as username
        ''')
  p = input('Enter your password: ').lower()
  for i in p:
    if i.isupper():
      upper += 1
    elif i.islower():
      lower += 1
    elif i.isdigit():
      digit += 1
    else:
      special += 1

  if len(p) < 8:
    print('Password is too short')
  elif p == user:
    print('Password should not be the same as username')
  elif upper == 0 or lower == 0 or digit == 0 or special == 0:
    print('Invalid Format')
  elif " " in p:
    print('Invalid Format')
  else:
    print('Password generated successfully')
else:
  print('Wrong username')
